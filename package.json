{
  "name": "belanja-pwa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.0.0" },
  "scripts": {
    "dev": "node scripts/server.mjs",
    "build": "node scripts/build.mjs",
    "start": "node scripts/server.mjs --dist",
    "test": "node --test tests/*.test.js",
    "android:sync": "pnpm build && cap sync android",
    "android:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android.ps1"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "tesseract.js"
    ]
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "8.1.2",
    "@capacitor/camera": "8.2.5",
    "@capacitor/core": "8.5.2",
    "@fontsource/inter": "5.2.8",
    "@tesseract.js-data/eng": "1.0.0",
    "tesseract.js": "6.0.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "esbuild": "0.28.2"
  }
}
